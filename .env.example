# ==============================================================
# CakeCart Production Environment Configuration (.env.example)
# ==============================================================

# Neon Serverless PostgreSQL (Vercel Marketplace)
# Pooled connection string for application runtime queries:
DATABASE_URL="postgres://user:password@ep-cool-base-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Direct / unpooled connection string for running Drizzle migrations:
DATABASE_URL_UNPOOLED="postgres://user:password@ep-cool-base-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secure Authentication & Session Cookies
JWT_SECRET="generate-a-strong-random-32-character-secret-key-here"

# Vercel Scheduled Cron Protection
CRON_SECRET="generate-a-secure-cron-secret-for-hold-cleanups"

# Vercel Blob Storage (for cake photos and customer reference images)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_from_dashboard"

# Test Mode Payment Provider (Stripe / Test Gateway)
PAYMENT_PROVIDER_KEY="mock_payment_provider_key_placeholder"
PAYMENT_WEBHOOK_SECRET="mock_payment_webhook_secret_placeholder"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
